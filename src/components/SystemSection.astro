---
// "¿Qué es el sistema All-on-4?" — video + explicación con pestañas.
// Las pestañas pasan de píldoras sueltas a un control segmentado
// real, con el panel visiblemente unido al grupo: así se lee como
// un solo objeto y no como tres botones flotando sobre una caja.

import VideoFrame, { type VideoData } from './VideoFrame.astro';
import type { Lang } from '../i18n/ui';

export interface SystemTab { label: string; title: string; text: string; }

export interface SystemData {
  id: string;
  eyebrow: string;
  heading: string;
  body: string;
  video: VideoData;
  videoRatio?: string;
  caption?: string;
  tabs?: SystemTab[];
}

interface Props { lang: Lang; data: SystemData; }
const { lang, data } = Astro.props;
---

<section id={data.id} class="section">
  <div class="container grid">
    <div class="media">
      <VideoFrame lang={lang} video={data.video} ratio={data.videoRatio ?? '1 / 1'} />
      {data.caption && <p class="media__caption">{data.caption}</p>}
    </div>

    <div class="copy psd-reveal">
      <span class="section-eyebrow">{data.eyebrow}</span>
      <h2 class="section-heading">{data.heading}</h2>
      <p class="section-text copy__body">{data.body}</p>

      {data.tabs && (
        <div class="parts">
          <div class="parts__tabs" role="tablist" id="psd-tabs">
            {data.tabs.map((tab, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${i}`}
                aria-controls={`panel-${i}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                data-idx={i}
                class:list={['parts__tab', i === 0 && 'is-active']}
              >
                {tab.label}
              </button>
            ))}
          </div>

          <div class="parts__panels">
            {data.tabs.map((tab, i) => (
              <div
                role="tabpanel"
                id={`panel-${i}`}
                aria-labelledby={`tab-${i}`}
                data-idx={i}
                class:list={['parts__panel', i === 0 && 'is-active']}
              >
                <h3 class="parts__title">{tab.title}</h3>
                <p class="parts__text">{tab.text}</p>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: 1fr; gap: clamp(2.5rem, 5vw, 4rem); align-items: center; }
  .media { order: 2; }
  .copy { order: 1; }
  @media (min-width: 1024px) {
    .grid { grid-template-columns: 1fr 1.05fr; }
    .media { order: 1; }
    .copy  { order: 2; }
  }

  .media__caption {
    text-align: center;
    font-size: var(--t-micro);
    color: var(--psd-ink-soft);
    margin: 14px 0 0;
  }

  .copy__body { margin-bottom: 32px; }

  /* ---------- Control segmentado ---------- */
  .parts {
    border: 1px solid #dde7f3;
    border-radius: var(--r-md);
    overflow: hidden;
    background: var(--psd-surface);
    box-shadow: var(--shadow-sm);
  }

  .parts__tabs {
    display: flex;
    background: var(--psd-surface-sunk);
    border-bottom: 1px solid #dde7f3;
  }
  .parts__tab {
    flex: 1;
    font-family: inherit;
    font-size: .8125rem;
    font-weight: 600;
    line-height: 1.3;
    padding: 14px 10px;
    min-height: 52px;
    border: none;
    border-bottom: 2px solid transparent;
    background: transparent;
    color: var(--psd-ink-soft);
    cursor: pointer;
    transition: color .18s ease, background-color .18s ease, border-color .18s ease;
  }
  .parts__tab:hover { color: var(--psd-primary); background: rgba(255,255,255,.6); }
  .parts__tab.is-active {
    color: var(--psd-primary);
    background: var(--psd-surface);
    border-bottom-color: var(--psd-accent);
  }

  .parts__panels { padding: 22px 24px; min-height: 124px; }
  .parts__panel { display: none; }
  .parts__panel.is-active { display: block; }
  .parts__title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--psd-primary);
    margin: 0 0 6px;
    letter-spacing: -0.01em;
  }
  .parts__text {
    font-size: var(--t-small);
    color: var(--psd-ink-soft);
    line-height: 1.68;
    margin: 0;
    max-width: 52ch;
  }
</style>

<script>
  const wrap = document.getElementById('psd-tabs');
  if (wrap) {
    const tabs = Array.from(wrap.querySelectorAll<HTMLButtonElement>('.parts__tab'));
    const panels = document.querySelectorAll<HTMLElement>('.parts__panel');

    const select = (idx: number) => {
      tabs.forEach((t) => {
        const on = t.dataset.idx === String(idx);
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      panels.forEach((p) => p.classList.toggle('is-active', p.dataset.idx === String(idx)));
    };

    tabs.forEach((tab) => tab.addEventListener('click', () => select(Number(tab.dataset.idx))));

    // Flechas izquierda/derecha entre pestañas, como espera un lector de pantalla
    wrap.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const current = tabs.findIndex((t) => t.classList.contains('is-active'));
      const next = (current + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
      select(next);
      tabs[next].focus();
    });
  }
</script>
