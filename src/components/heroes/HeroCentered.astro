---
// HERO — grid de dos columnas: texto a la izquierda, video a la derecha.
// Debajo, a todo lo ancho, la franja de confianza.

import VideoFrame, { type VideoData } from '../VideoFrame.astro';
import type { Lang } from '../../i18n/ui';

export interface TrustItem { icon: string; label: string; }

export interface HeroCenteredData {
  variant: 'centered';
  bg: string;
  badge: string;
  titleBefore: string;
  titleAccent: string;
  titleAfter?: string;
  subtitle: string;
  primaryCta: string;
  secondaryCta: string;
  video: VideoData;
  trust: TrustItem[];
}

interface Props { lang: Lang; data: HeroCenteredData; }
const { lang, data } = Astro.props;
---

<section class="hero">
  <div class="hero__bg" style={`background-image: url('${data.bg}');`}></div>
  <div class="hero__scrim"></div>

  <div class="container hero__inner">
    <div class="hero__grid">
      <div class="hero__copy">
        <p class="hero__badge">
          <span class="hero__badge-dot psd-pulse-dot"></span>
          {data.badge}
        </p>

        <h1 class="hero__title display">
          {data.titleBefore}{' '}
          <em class="hero__accent">{data.titleAccent}</em>
          {data.titleAfter && <>{' '}{data.titleAfter}</>}
        </h1>

        <p class="hero__sub">{data.subtitle}</p>

        <div class="hero__actions">
          <a href="#contacto" class="btn btn--accent">{data.primaryCta}</a>
          <a href="#por-que-tijuana" class="btn btn--ghost-light">{data.secondaryCta}</a>
        </div>
      </div>

      <div class="hero__media">
        <VideoFrame lang={lang} video={data.video} ratio="4 / 4.6" />
      </div>
    </div>

    <ul class="trust">
      {data.trust.map((item) => (
        <li class="trust__item">
          <span class="trust__icon">
            <span class="material-symbols-outlined">{item.icon}</span>
          </span>
          <span class="trust__label">{item.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .hero { position: relative; overflow: hidden; background: var(--psd-primary-dark); }

  .hero__bg {
    position: absolute; inset: 0;
    background-size: cover; background-position: 70% 30%;
    opacity: .28;
  }
  .hero__scrim {
    position: absolute; inset: 0;
    background: linear-gradient(105deg, rgba(0,20,42,.96) 0%, rgba(0,20,42,.86) 45%, rgba(0,27,60,.72) 100%);
  }

  .hero__inner {
    position: relative; z-index: 1;
    padding-top: clamp(3rem, 7vw, 5.5rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }

  .hero__grid {
    display: grid; grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem); align-items: center;
  }
  @media (min-width: 1024px) {
    .hero__grid { grid-template-columns: 1.08fr 1fr; gap: 4.5rem; }
  }
  .hero__copy, .hero__media { min-width: 0; }

  .hero__badge {
    display: inline-flex; align-items: center; gap: 10px;
    margin: 0 0 clamp(1.25rem, 3vw, 1.75rem);
    padding: 7px 14px 7px 12px;
    border-radius: var(--r-chip);
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.16);
    font-size: var(--t-small); font-weight: 500;
    color: rgba(255,255,255,.92);
  }
  .hero__badge-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--psd-day); flex-shrink: 0;
  }

  .hero__title {
    color: #fff;
    font-size: clamp(2.25rem, 1.3rem + 3.2vw, 4rem);
    margin: 0 0 clamp(1rem, 2vw, 1.375rem);
    max-width: 16ch;
    text-wrap: balance;
  }
  /* La promesa en cursiva de la misma serif, azul claro */
  .hero__accent {
    font-style: italic; font-weight: 500;
    color: var(--psd-blue-200);
    white-space: nowrap;
  }

  .hero__sub {
    font-size: var(--t-lead);
    color: rgba(255,255,255,.82);
    line-height: 1.6;
    margin: 0 0 clamp(1.75rem, 3vw, 2.25rem);
    max-width: 44ch;
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 14px; }

  /* Franja de confianza */
  .trust {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 22px 0 0;
    border-top: 1px solid rgba(255,255,255,.18);
    display: grid; grid-template-columns: 1fr; gap: 14px;
  }
  @media (min-width: 640px) {
    .trust { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  }
  .trust__item { display: flex; align-items: center; gap: 12px; }
  .trust__icon {
    width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0;
    display: grid; place-items: center;
    background: rgba(255,255,255,.08);
    border: 1px solid rgba(255,255,255,.16);
  }
  .trust__icon :global(.material-symbols-outlined) { font-size: 20px; color: var(--psd-blue-200); }
  .trust__label { font-size: .9375rem; font-weight: 600; color: #fff; }

  @media (prefers-reduced-motion: no-preference) {
    .hero__badge, .hero__title, .hero__sub, .hero__actions, .hero__media, .trust {
      animation: hero-in .7s cubic-bezier(.2, .7, .3, 1) backwards;
    }
    .hero__badge   { animation-delay: .05s; }
    .hero__title   { animation-delay: .14s; }
    .hero__media   { animation-delay: .20s; }
    .hero__sub     { animation-delay: .24s; }
    .hero__actions { animation-delay: .32s; }
    .trust         { animation-delay: .42s; }
  }
  @keyframes hero-in {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: none; }
  }
</style>