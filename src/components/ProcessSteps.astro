---
// Proceso clínico.
// Aquí los números SÍ están justificados: el contenido es una
// secuencia real con orden obligatorio. Pasan de ser un eyebrow
// pequeño ("PASO 1") a ser el elemento estructural de la sección.

export interface ProcessStep { icon: string; eyebrow: string; title: string; text: string; }

export interface ProcessData {
  id: string;
  eyebrow: string;
  heading: string;
  steps: ProcessStep[];
}

interface Props { data: ProcessData; }
const { data } = Astro.props;
---

<section id={data.id} class="section">
  <div class="container">
    <div class="section-intro psd-reveal">
      <span class="section-eyebrow">{data.eyebrow}</span>
      <h2 class="section-heading">{data.heading}</h2>
    </div>

    <ol class="steps">
      {data.steps.map((step, i) => (
        <li class="step">
          <div class="step__head">
            <span class="step__num">{i + 1}</span>
            <span class="step__rule"></span>
          </div>
          <span class="step__icon material-symbols-outlined">{step.icon}</span>
          <h3 class="step__title">{step.title}</h3>
          <p class="step__text">{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  @media (min-width: 900px) {
    .steps { grid-template-columns: repeat(3, 1fr); gap: 36px; }
  }

  .step { display: flex; flex-direction: column; }

  /* El número y la regla que lo sigue forman la secuencia.
     La regla se corta sola en el último paso. */
  .step__head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 22px;
  }
  .step__num {
    font-family: 'Fraunces', Georgia, serif;
    font-variation-settings: 'SOFT' 0, 'WONK' 0, 'opsz' 100;
    font-size: 2.75rem;
    font-weight: 600;
    line-height: 1;
    color: var(--psd-accent);
    letter-spacing: -0.03em;
    flex-shrink: 0;
    font-variant-numeric: lining-nums;
  }
  .step__rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--psd-blue-200), rgba(175,204,255,0));
  }
  .step:last-child .step__rule { display: none; }

  .step__icon {
    color: var(--psd-accent);
    font-size: 24px;
    margin-bottom: 12px;
  }
  .step__title {
    font-size: var(--t-h3);
    font-weight: 700;
    color: var(--psd-primary);
    letter-spacing: -0.015em;
    line-height: 1.3;
    margin: 0 0 8px;
  }
  .step__text {
    font-size: var(--t-small);
    color: var(--psd-ink-soft);
    line-height: 1.68;
    margin: 0;
    max-width: 42ch;
  }
</style>
