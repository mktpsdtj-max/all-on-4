---

import { useTranslations, type Lang } from '../i18n/ui';

export interface StoryCase {
  before: { src: string; alt: string };
  after: { src: string; alt: string };
  /** Opcional: "Arcada superior", "Caso de 6 meses"… */
  note?: string;
}

export interface StoriesData {
  id: string;
  eyebrow: string;
  heading: string;
  intro: string;
  cases: StoryCase[];
}

interface Props { lang: Lang; data: StoriesData; }
const { lang, data } = Astro.props;
const t = useTranslations(lang);
---

<section id={data.id} class="section section--white">
  <div class="container">
    <div class="section-intro section-intro--wide psd-reveal">
      <span class="section-eyebrow">{data.eyebrow}</span>
      <h2 class="section-heading">{data.heading}</h2>
      <p class="section-text">{data.intro}</p>
    </div>

    <div class="cases">
      {data.cases.map((c, i) => (
        <figure class="ba" style="--pos: 50%">
          <div class="ba__stage">
            <img class="ba__img" src={c.before.src} alt={c.before.alt} loading="lazy" decoding="async" />
            <img class="ba__img ba__img--after" src={c.after.src} alt={c.after.alt} loading="lazy" decoding="async" />

            <span class="ba__line" aria-hidden="true"></span>
            <span class="ba__knob" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="currentColor">
                <path d="M9.5 7 5 12l4.5 5V7Zm5 0v10l4.5-5-4.5-5Z" />
              </svg>
            </span>

            <span class="ba__tag ba__tag--before">{t('ba.before')}</span>
            <span class="ba__tag ba__tag--after">{t('ba.after')}</span>

            <input
              class="ba__range"
              type="range"
              min="0"
              max="100"
              value="50"
              step="0.1"
              aria-label={`${t('ba.slider')} — ${t('ba.case')} ${i + 1}`}
            />
          </div>
          {c.note && <figcaption class="ba__note">{c.note}</figcaption>}
        </figure>
      ))}
    </div>

    <p class="cases__hint">{t('ba.hint')}</p>
  </div>
</section>

<style>
  .cases {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 560px) { .cases { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .cases { grid-template-columns: repeat(3, 1fr); gap: 20px; } }

  .ba { margin: 0; }

  /* Marco oscuro: las fotos clínicas vienen sobre fondo negro,
     así el recorte no se nota y el caso se lee como una pieza. */
  .ba__stage {
    position: relative;
    aspect-ratio: 1 / 1;
    border-radius: var(--r-md);
    overflow: hidden;
    background: #0a0a0a;
    box-shadow: var(--shadow-md);
    isolation: isolate;
  }

  .ba__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* La foto "después" se recorta desde la izquierda hasta --pos.
     Mover --pos es todo lo que hace el JS. */
  .ba__img--after { clip-path: inset(0 0 0 var(--pos)); }

  .ba__line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, .18);
    pointer-events: none;
  }

  .ba__knob {
    position: absolute;
    top: 50%;
    left: var(--pos);
    transform: translate(-50%, -50%);
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, .92);
    color: var(--psd-primary-dark);
    display: grid;
    place-items: center;
    box-shadow: 0 2px 10px rgba(0, 0, 0, .35);
    pointer-events: none;
    transition: transform .14s ease;
  }
  .ba__stage:hover .ba__knob { transform: translate(-50%, -50%) scale(1.06); }

  .ba__tag {
    position: absolute;
    top: 12px;
    font-size: var(--t-micro);
    font-weight: 600;
    letter-spacing: .02em;
    color: #fff;
    background: rgba(8, 20, 34, .62);
    backdrop-filter: blur(4px);
    padding: 5px 11px;
    border-radius: var(--r-chip);
    pointer-events: none;
  }
  .ba__tag--before { left: 12px; }
  .ba__tag--after  { right: 12px; }

  /* El control real: invisible, encima de todo.
     Nos da teclado, táctil y lector de pantalla sin escribir nada. */
  .ba__range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    cursor: ew-resize;
    z-index: 2;
  }
  .ba__range::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 46px;
    height: 100vh; /* alto para poder arrastrar desde cualquier punto */
    background: transparent;
    cursor: ew-resize;
  }
  .ba__range::-moz-range-thumb {
    width: 46px;
    height: 100vh;
    border: 0;
    background: transparent;
    cursor: ew-resize;
  }
  .ba__range::-moz-range-track { background: transparent; border: 0; }

  /* El foco se dibuja sobre el marco, no sobre el input invisible */
  .ba__range:focus-visible { outline: none; }
  .ba__stage:has(.ba__range:focus-visible) {
    outline: 3px solid var(--psd-accent);
    outline-offset: 3px;
  }

  .ba__note {
    margin: 10px 2px 0;
    font-size: var(--t-small);
    color: var(--psd-ink-soft);
    line-height: 1.5;
  }

  .cases__hint {
    margin: 26px 0 0;
    font-size: var(--t-small);
    color: var(--psd-ink-soft);
    text-align: center;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.ba').forEach((card) => {
    const range = card.querySelector<HTMLInputElement>('.ba__range');
    if (!range) return;

    const apply = () => card.style.setProperty('--pos', `${range.value}%`);
    range.addEventListener('input', apply);
    apply();
  });
</script>