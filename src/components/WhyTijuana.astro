---
// "¿Por qué Tijuana?" — bento: el ahorro ocupa 2×2, las otras dos
// tarjetas se apilan a la derecha. El mapa vive en LocationMap.astro.

export interface WhyCompare {
  fromLabel: string;
  toLabel: string;
  /** 30 = la barra de Tijuana mide 30% de la de EE. UU. */
  toPercent: number;
}

export interface WhyCard {
  icon: string;
  tone?: 'blue' | 'savings';
  title: string;
  text: string;
  figureLead?: string;
  figure?: string;
  figureNote?: string;
  compare?: WhyCompare;
  wide?: boolean;
}

export interface WhyData {
  id: string;
  eyebrow: string;
  heading: string;
  cards: WhyCard[];
}

interface Props { data: WhyData; }
const { data } = Astro.props;
---

<section id={data.id} class="section section--white">
  <div class="container">
    <div class="section-intro section-intro--wide psd-reveal">
      <span class="section-eyebrow">{data.eyebrow}</span>
      <h2 class="section-heading">{data.heading}</h2>
    </div>

    <div class="why">
      {data.cards.map((card) =>
        card.figure ? (
          <article class:list={['card', 'card--savings', card.wide && 'card--wide']}>
            <div class="stat">
              {card.figureLead && <span class="stat__lead">{card.figureLead}</span>}
              <span class="stat__figure">{card.figure}</span>
              {card.figureNote && <span class="stat__note">{card.figureNote}</span>}
            </div>

            {card.compare && (
              <div class="bars" role="img" aria-label={`${card.compare.fromLabel}: 100%. ${card.compare.toLabel}: ${card.compare.toPercent}%.`}>
                <div class="bar">
                  <span class="bar__label">{card.compare.fromLabel}</span>
                  <span class="bar__track"><span class="bar__fill bar__fill--from" style="--w: 100%"></span></span>
                </div>
                <div class="bar">
                  <span class="bar__label bar__label--to">{card.compare.toLabel}</span>
                  <span class="bar__track"><span class="bar__fill bar__fill--to" style={`--w: ${card.compare.toPercent}%`}></span></span>
                </div>
              </div>
            )}

            <div class="card__body">
              <h3 class="card__title">{card.title}</h3>
              <p class="card__text" set:html={card.text} />
            </div>
          </article>
        ) : (
          <article class="card">
            <span class:list={['card__icon', `card__icon--${card.tone ?? 'blue'}`]}>
              <span class="material-symbols-outlined">{card.icon}</span>
            </span>
            <h3 class="card__title">{card.title}</h3>
            <p class="card__text" set:html={card.text} />
          </article>
        )
      )}
    </div>
  </div>
</section>

<style>
  .why { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 900px) {
    .why { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
    .card--wide { grid-column: span 2; grid-row: span 2; }
  }

  .card {
    background: var(--psd-bg);
    border: 1px solid #e2eaf4;
    border-radius: var(--r-md);
    padding: clamp(22px, 2.5vw, 30px);
    display: flex; flex-direction: column;
  }

  .card__icon {
    width: 44px; height: 44px; border-radius: var(--r-sm);
    display: inline-flex; align-items: center; justify-content: center;
    margin-bottom: 16px;
  }
  .card__icon--blue { background: var(--psd-blue-100); color: var(--psd-accent); }
  .card__icon--savings { background: var(--psd-savings-soft); color: var(--psd-savings); }

  .card__title {
    font-size: var(--t-h3); font-weight: 700;
    color: var(--psd-primary);
    letter-spacing: -0.015em; line-height: 1.3;
    margin: 0 0 8px;
  }
  .card__text {
    font-size: var(--t-small); color: var(--psd-ink-soft);
    line-height: 1.68; margin: 0; max-width: 52ch;
  }
  .card__text :global(.feature-card__highlight) { font-weight: 700; color: var(--psd-savings); }

  /* ---------- Tarjeta de ahorro ---------- */
  .card--savings {
    position: relative; overflow: hidden;
    background:
      radial-gradient(120% 90% at 100% 0%, rgba(15,122,70,.10), transparent 60%),
      var(--psd-savings-soft);
    border-color: #c8e6d5;
    gap: clamp(22px, 3vw, 32px);
  }

  /* Cifra y nota en bloques separados: la nota nunca hereda el tamaño de la cifra */
  .stat { display: flex; flex-direction: column; align-items: flex-start; }
  .stat__lead {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: .8125rem; font-weight: 600; letter-spacing: .02em;
    color: var(--psd-savings); margin-bottom: 4px;
  }
  .stat__figure {
    font-family: 'Fraunces', Georgia, serif;
    font-variation-settings: 'SOFT' 0, 'WONK' 0, 'opsz' 144;
    font-size: clamp(4rem, 2.6rem + 5vw, 6.5rem);
    font-weight: 600; line-height: .9; letter-spacing: -0.045em;
    color: var(--psd-primary);
  }
  .stat__note {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: .9375rem; font-weight: 500; line-height: 1.4; letter-spacing: 0;
    color: var(--psd-ink);
    margin-top: 10px; max-width: 30ch;
  }

  .bars { display: grid; gap: 12px; max-width: 520px; }
  .bar { display: grid; gap: 6px; }
  .bar__label { font-size: var(--t-micro); font-weight: 600; color: var(--psd-ink-soft); }
  .bar__label--to { color: var(--psd-savings); }
  .bar__track {
    display: block; height: 12px; border-radius: var(--r-chip);
    background: rgba(12,27,42,.06); overflow: hidden;
  }
  .bar__fill { display: block; height: 100%; width: var(--w); border-radius: inherit; }
  .bar__fill--from { background: #b9c4d0; }
  .bar__fill--to { background: var(--psd-savings); }

  /* Desktop: cifra y barras lado a lado, sin hueco vacío */
  @media (min-width: 1100px) {
    .card--savings {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      column-gap: 40px;
      align-content: space-between;
    }
    .card--savings .bars { align-self: end; max-width: none; }
    .card--savings .card__body { grid-column: 1 / -1; }
  }

  .card__body { margin-top: auto; }
  .card--savings .card__title { font-size: clamp(1.25rem, 1.05rem + .8vw, 1.6rem); }
</style>