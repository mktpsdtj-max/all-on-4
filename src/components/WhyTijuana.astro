---
// "¿Por qué Tijuana?" — la sección que derriba la objeción del precio
// y la del cruce fronterizo.
//
// Antes: tres tarjetas iguales. El 70% de ahorro, que es EL argumento,
// iba en el mismo cuerpo de texto que todo lo demás. Ahora la cifra
// se lee antes que la frase, y el mapa deja de ser un recuadro al
// costado para volverse el ancla de la columna derecha.

import { useTranslations, contact, type Lang } from '../i18n/ui';

export interface WhyCard {
  icon: string;
  tone?: 'blue' | 'savings';
  title: string;
  text: string;
  /** Cifra grande: el dato que carga el argumento (ej. "70%") */
  figure?: string;
  figureNote?: string;
  wide?: boolean;
}

export interface WhyData {
  id: string;
  eyebrow: string;
  heading: string;
  cards: WhyCard[];
}

interface Props { lang: Lang; data: WhyData; }
const { lang, data } = Astro.props;
const t = useTranslations(lang);
---

<section id={data.id} class="section section--white">
  <div class="container">
    <div class="section-intro section-intro--wide psd-reveal">
      <span class="section-eyebrow">{data.eyebrow}</span>
      <h2 class="section-heading">{data.heading}</h2>
    </div>

    <div class="why">
      <div class="why__cards">
        {data.cards.map((card) => (
          <article
            class:list={[
              'card',
              card.wide && 'card--wide',
              card.tone === 'savings' && 'card--savings',
            ]}
          >
            {card.figure && (
              <p class="card__figure">
                {card.figure}
                {card.figureNote && <span class="card__figure-note">{card.figureNote}</span>}
              </p>
            )}
            {!card.figure && (
              <span class:list={['card__icon', `card__icon--${card.tone ?? 'blue'}`]}>
                <span class="material-symbols-outlined">{card.icon}</span>
              </span>
            )}
            <h3 class="card__title">{card.title}</h3>
            <p class="card__text" set:html={card.text} />
          </article>
        ))}
      </div>

      <aside class="why__map">
        <div class="map-frame">
          <iframe
            src={contact.mapEmbed}
            title={t('map.title')}
            loading="lazy"
            allowfullscreen
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>
        <p class="map-note">
          <span class="material-symbols-outlined">directions_walk</span>
          <span set:html={t('map.note')} />
        </p>
      </aside>
    </div>
  </div>
</section>

<style>
  .why { display: grid; grid-template-columns: 1fr; gap: 28px; align-items: start; }
  @media (min-width: 1024px) { .why { grid-template-columns: 1.35fr 1fr; gap: 40px; } }

  .why__cards { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 640px) { .why__cards { grid-template-columns: 1fr 1fr; } }

  .card {
    background: var(--psd-bg);
    border: 1px solid #e2eaf4;
    border-radius: var(--r-md);
    padding: 24px;
  }
  .card--wide { grid-column: 1 / -1; }

  .card__icon {
    width: 42px;
    height: 42px;
    border-radius: var(--r-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
  }
  .card__icon--blue { background: var(--psd-blue-100); color: var(--psd-accent); }
  .card__icon--savings { background: var(--psd-savings-soft); color: var(--psd-savings); }

  /* La cifra sustituye al ícono cuando el dato es el argumento. */
  .card__figure {
    font-family: 'Fraunces', Georgia, serif;
    font-variation-settings: 'SOFT' 0, 'WONK' 0, 'opsz' 144;
    font-size: clamp(3rem, 2rem + 4vw, 4.5rem);
    font-weight: 600;
    line-height: .92;
    letter-spacing: -0.04em;
    color: var(--psd-savings);
    margin: 0 0 10px;
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .card__figure-note {
    font-family: 'Inter', sans-serif;
    font-size: var(--t-small);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--psd-ink-soft);
  }

  .card--savings {
    background: var(--psd-savings-soft);
    border-color: #c8e6d5;
  }

  .card__title {
    font-size: var(--t-h3);
    font-weight: 700;
    color: var(--psd-primary);
    letter-spacing: -0.015em;
    line-height: 1.3;
    margin: 0 0 7px;
  }
  .card__text {
    font-size: var(--t-small);
    color: var(--psd-ink-soft);
    line-height: 1.68;
    margin: 0;
    max-width: 48ch;
  }
  .card__text :global(.feature-card__highlight) {
    font-weight: 700;
    color: var(--psd-savings);
  }

  /* ---------- Mapa ---------- */
  .map-frame {
    border-radius: var(--r-lg);
    overflow: hidden;
    border: 1px solid #e2eaf4;
    box-shadow: var(--shadow-md);
  }
  .map-frame iframe { width: 100%; height: 300px; border: 0; display: block; }
  @media (min-width: 1024px) { .map-frame iframe { height: 380px; } }

  .map-note {
    margin: 14px 0 0;
    display: flex;
    align-items: center;
    gap: 11px;
    font-size: var(--t-small);
    color: var(--psd-ink-soft);
    line-height: 1.5;
  }
  .map-note :global(.material-symbols-outlined) { color: var(--psd-accent); flex-shrink: 0; }
  .map-note :global(strong) { color: var(--psd-primary); font-weight: 600; }
</style>
