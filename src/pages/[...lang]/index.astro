---
// ============================================================
// Genera / (inglés, principal) y /es/ (español).
// El parámetro es opcional: cuando viene undefined, Astro
// escribe la página en la raíz del subdominio.
// ============================================================
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroCentered from '../../components/heroes/HeroCentered.astro';
import WhyTijuana from '../../components/WhyTijuana.astro';
import SystemSection from '../../components/SystemSection.astro';
import BenefitsGrid from '../../components/BenefitsGrid.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import StoriesGallery from '../../components/StoriesGallery.astro';
import LocationMap from '../../components/LocationMap.astro';
import CtaFinal from '../../components/CtaFinal.astro';
import content, { type PageContent } from '../../data/content';
import { defaultLang, localizedPath, otherLang, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return (Object.keys(content) as Lang[]).map((lang) => ({
    // El idioma principal no lleva prefijo: params.lang = undefined -> "/"
    params: { lang: lang === defaultLang ? undefined : lang },
    props: { lang, data: content[lang] },
  }));
}

interface Props { lang: Lang; data: PageContent; }
const { lang, data } = Astro.props;

const altLang = otherLang(lang);
const altHref = localizedPath(altLang);
---

<BaseLayout
  lang={lang}
  altLang={altLang}
  title={data.seo.title}
  description={data.seo.description}
  navLinks={data.nav}
  altHref={altHref}
>
  <HeroCentered lang={lang} data={data.hero} />
  <WhyTijuana data={data.why} />
  <SystemSection lang={lang} data={data.system} />
  <BenefitsGrid data={data.benefits} />
  <ProcessSteps data={data.process} />
  <StoriesGallery lang={lang} data={data.stories} />
  <LocationMap lang={lang} data={data.location} />
  <CtaFinal lang={lang} data={data.cta} />
</BaseLayout>